# ---------------------------------------------------------------------------
# Portal ABRADILAN — variáveis de ambiente
# Copie para .env e preencha. Nunca versione o .env.
# ---------------------------------------------------------------------------

# Desenvolvimento: SQLite. Produção: Postgres (troque o provider no schema).
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://usuario:senha@host:5432/abradilan?schema=public"

# Segredo de assinatura das sessões JWT. GERE UM VALOR FORTE EM PRODUÇÃO.
AUTH_SECRET="troque-por-um-segredo-forte-em-producao"

# URL pública do portal — usada nos links de convite e nos QR codes.
BASE_URL="https://abradilanviagens.mais.tur.br"

# ---- Sistema externo de consulta e solicitação de aéreo ----
# Destino do card "Consulta e solicitação de aéreo" na área do associado.
AEREO_URL="https://travellink.pontodeviagem.tur.br/"

# ---- Linha direta de viagens ----
# WhatsApp do atendente dedicado que recebe os briefings (DDD + número).
LINHA_DIRETA_WHATSAPP="5511900000000"
LINHA_DIRETA_NOME="Atendimento ABRADILAN — Mais Corporativo"

# ---- E-mail (SMTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Portal ABRADILAN <no-reply@abradilanviagens.mais.tur.br>"

# ---- WhatsApp (Evolution API) ----
# Atenção: estes são os nomes lidos por src/lib/messaging.ts.
EVOLUTION_URL=
EVOLUTION_APIKEY=
EVOLUTION_INSTANCE=
